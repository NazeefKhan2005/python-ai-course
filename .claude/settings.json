{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(.venv/bin/python tools/*)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python -m ruff *)",
      "Bash(.venv/bin/python -m ruff *)",
      "Bash(python -m pip install -r *)",
      "Bash(.venv/bin/python -m pip install -r *)",
      "Bash(python --version)",
      "Bash(node tools/smoke_pages.mjs)",
      "Bash(npm install --no-save *)",
      "Bash(jupyter nbconvert *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:peps.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:numpy.org)",
      "WebFetch(domain:pandas.pydata.org)",
      "WebFetch(domain:matplotlib.org)",
      "WebFetch(domain:docs.scipy.org)",
      "WebFetch(domain:scikit-learn.org)",
      "WebFetch(domain:docs.pytorch.org)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:mlflow.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh api --method *)",
      "Bash(gh api -X *)",
      "Bash(gh workflow run *)",
      "Edit(/CLAUDE.md)",
      "Edit(/spec/**)",
      "Edit(/site/downloads/requirements-*.txt)",
      "Edit(/tools/requirements-dev.txt)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/site/assets/js/manifest.js)",
      "Edit(/site/assets/js/search-index.js)",
      "Edit(/site/api-index.html)",
      "Edit(/site/assets/vendor/**)",
      "Edit(/site/assets/fonts/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)"
    ]
  }
}
